# LightMail — example environment configuration.
# Copy to `.env` and fill in the required values:  cp .env.example .env

# REQUIRED — 64 hex characters (32 bytes). The server exits on startup without it.
# Generate one with:  openssl rand -hex 32
ENCRYPTION_KEY=

# HTTP port the server listens on (default: 3000)
PORT=3000

# Bind address (default: 127.0.0.1). Deliberately loopback-only — the API has no auth.
# Set to 0.0.0.0 only if LAN access is truly wanted.
HOST=127.0.0.1

# Override the SQLite database location (default: data/mail.db)
DB_PATH=data/mail.db

# Set to 1 to allow insecure TLS for self-signed IMAP/SMTP servers.
# Certificates are verified by default — leave empty unless you must.
MAIL_ALLOW_INSECURE_TLS=

# Runtime environment: development | production | test
NODE_ENV=development
